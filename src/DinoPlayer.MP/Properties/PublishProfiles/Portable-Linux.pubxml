<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed and precompiled: ready in about 0.3 s instead of 0.7 s, for a zip about 20 MB larger. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <DinoPlayerPortable>true</DinoPlayerPortable>
    <PublishDir>$(MSBuildProjectDirectory)/../../publish/portable-linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
